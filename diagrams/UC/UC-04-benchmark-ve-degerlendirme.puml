@startuml UC_04_benchmark_ve_degerlendirme
title Agentic IDE - Benchmark ve Değerlendirme Use Case Diyagramı
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Danışman / Araştırmacı" as Researcher
actor "Katılımcı Öğrenci" as Participant
actor "Dış Değerlendirici" as Reviewer
actor "Agentic IDE" as AgentIDE
actor "Audit ve Metrik Kayıtları" as MetricsStore

rectangle "Değerlendirme ve Benchmark Katmanı" {
  usecase "Benchmark görev setini tanımla" as UC_DefineTasks
  usecase "Beklenen çıktıları belgeleyip\npuanlama kuralı oluştur" as UC_DefineRubric
  usecase "Deney koşulunu seç\n(A / B / C)" as UC_SelectCondition
  usecase "Baseline oturumu çalıştır\n(ajan olmadan)" as UC_RunBaseline
  usecase "Agentic IDE oturumu çalıştır" as UC_RunAgentSession
  usecase "Görev sırasını\ncounterbalance et" as UC_Counterbalance
  usecase "Katılımcı görevini tamamla" as UC_CompleteTask
  usecase "Audit ve metrikleri topla" as UC_CollectMetrics
  usecase "Çıktıları anonimleştir" as UC_AnonymizeOutputs
  usecase "Görev başarı oranını ölç" as UC_MeasureSuccess
  usecase "Successful unauthorized\nwrite count ölç" as UC_MeasureUnauthorizedWrite
  usecase "Blocked attempt count\nraporla" as UC_MeasureBlockedAttempts
  usecase "Pre-apply reject\noranını ölç" as UC_MeasureReject
  usecase "Post-apply rollback\noranını ölç" as UC_MeasureRollback
  usecase "Yanlış atıf / hallucination\noranını ölç" as UC_MeasureAccuracy
  usecase "Gecikme ve model\nperformansını ölç" as UC_MeasureLatency
  usecase "Retrieval doğruluğunu ölç\n(Precision@5)" as UC_MeasureRetrievalAccuracy
  usecase "Token verimliliğini ölç" as UC_MeasureTokenEfficiency
  usecase "Tamamlanma süresini ölç" as UC_MeasureCompletionTime
  usecase "Onay yorulma\ngöstergesini ölç" as UC_MeasureApprovalFatigue
  usecase "Sonuçları karşılaştır" as UC_CompareResults
  usecase "Tez raporu ve bulguları üret" as UC_GenerateReport
}

