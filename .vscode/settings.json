{
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.associations": {
    "*.puml": "plantuml"
  },
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/out/**": true,
    "**/coverage/**": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/out": true,
    "**/coverage": true
  },
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },
  "problems.autoReveal": true,
  "json.validate.enable": true,
  "json.schemas": [
    {
      "fileMatch": ["/github-projects/requirements-analysis.json"],
      "url": "./docs/schemas/requirements-project.schema.json"
    }
  ],
  "yaml.validate": true,
  "yaml.schemaStore.enable": true,
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.{yml,yaml}",
    "https://json.schemastore.org/dependabot-2.0.json": ".github/dependabot.yml"
  },
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.lintTask.enable": true,
  "eslint.format.enable": false,
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
  "js/ts.tsserver.maxMemory": 4096,
  "powershell.scriptAnalysis.enable": true,
  "powershell.codeFormatting.autoCorrectAliases": true,
  "powershell.codeFormatting.useCorrectCasing": true,
  "plantuml.diagramsRoot": "diagrams",
  "plantuml.exportOutDir": "out/diagrams",
  "markdownlint.config": {
    "MD013": false,
    "MD033": false,
    "MD041": false
  }
}
