{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TurkishKEBAB/Agentic-Ide/schemas/requirements-project.schema.json",
  "title": "Agentic IDE GitHub Project Seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "labels", "issues"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "fields", "views"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "dataType"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "dataType": {
                "type": "string",
                "enum": ["TEXT", "NUMBER", "DATE", "SINGLE_SELECT", "ITERATION"]
              },
              "options": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "layout"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "layout": {
                "type": "string",
                "enum": ["table", "board", "roadmap"]
              },
              "filter": { "type": "string" },
              "groupBy": { "type": "string" },
              "sortBy": {
                "type": "array",
                "items": { "type": "string" }
              },
              "visibleFields": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "color", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "color": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{6}$"
          },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "kind",
          "title",
          "status",
          "area",
          "requirementType",
          "phase",
          "priority",
          "labels",
          "requirement",
          "rationale",
          "acceptanceSummary",
          "acceptanceCriteria",
          "outOfScope",
          "sourceDocuments"
        ],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "parentKey": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["epic", "issue"]
          },
          "title": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["Draft", "Advisor Review", "Approved", "Planned", "In Progress", "Done", "Deferred"]
          },
          "area": {
            "type": "string",
            "enum": ["Research", "Editor", "Agent", "Retrieval", "Safety", "UX", "Model", "Testing", "Evaluation", "Thesis"]
          },
          "requirementType": {
            "type": "string",
            "enum": ["Functional", "Non-Functional", "Research", "Risk"]
          },
          "phase": {
            "type": "string",
            "enum": ["Faz 1", "Faz 2", "Faz 3"]
          },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2"]
          },
          "targetDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "labels": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "requirement": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "acceptanceSummary": { "type": "string", "minLength": 1 },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "outOfScope": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceDocuments": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
