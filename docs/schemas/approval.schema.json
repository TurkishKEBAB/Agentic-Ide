{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TurkishKEBAB/Agentic-Ide/schemas/approval.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalId",
    "actor",
    "workspaceId",
    "patchSetId",
    "fingerprint",
    "selectedPaths",
    "decision",
    "decidedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "approvalId": {
      "$ref": "contract-types.schema.json#/$defs/id"
    },
    "actor": {
      "const": "user"
    },
    "workspaceId": {
      "$ref": "contract-types.schema.json#/$defs/id"
    },
    "patchSetId": {
      "$ref": "contract-types.schema.json#/$defs/id"
    },
    "fingerprint": {
      "$ref": "contract-types.schema.json#/$defs/hash"
    },
    "selectedPaths": {
      "type": "array",
      "items": {
        "$ref": "contract-types.schema.json#/$defs/relativePath"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "decidedAt": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    }
  }
}
