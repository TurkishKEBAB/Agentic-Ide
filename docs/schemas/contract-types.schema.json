{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TurkishKEBAB/Agentic-Ide/schemas/contract-types.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*/$)[^\\\\:\\x00-\\x1f]+$(?![\\s\\S])"
    },
    "condition": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "not-applicable"
      ]
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementationPrompt",
        "verificationPolicy",
        "retrievalPolicy",
        "safetyPolicy",
        "taskVersion",
        "requirementsVersion"
      ],
      "properties": {
        "implementationPrompt": {
          "type": "string",
          "minLength": 1
        },
        "verificationPolicy": {
          "type": "string",
          "minLength": 1
        },
        "retrievalPolicy": {
          "type": "string",
          "minLength": 1
        },
        "safetyPolicy": {
          "type": "string",
          "minLength": 1
        },
        "taskVersion": {
          "type": "string",
          "minLength": 1
        },
        "requirementsVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "id",
        "version",
        "temperature"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    }
  }
}
