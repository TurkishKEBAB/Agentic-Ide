{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TurkishKEBAB/Agentic-Ide/schemas/plan.schema.json",
  "title": "Agentic IDE Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["planId", "createdAt", "model", "goal", "steps", "affectedFiles", "riskLevel", "requiresApproval"],
  "properties": {
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "taskId": {
      "type": "string"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name"],
      "properties": {
        "provider": { "type": "string" },
        "name": { "type": "string" },
        "id": { "type": "string" },
        "version": { "type": "string" },
        "temperature": { "type": "number" }
      }
    },
    "promptVersion": {
      "type": "string"
    },
    "retrievalPolicyVersion": {
      "type": "string"
    },
    "safetyPolicyVersion": {
      "type": "string"
    },
    "verificationRequired": {
      "type": "boolean",
      "const": true
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "status"],
        "properties": {
          "summary": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["planned", "blocked", "skipped"]
          }
        }
      }
    },
    "affectedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "operation", "reason"],
        "properties": {
          "path": { "type": "string" },
          "operation": {
            "type": "string",
            "enum": ["read", "create", "modify", "delete"]
          },
          "reason": { "type": "string" },
          "requiresExplicitApproval": { "type": "boolean" }
        }
      }
    },
    "contextSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "riskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "blocked"]
    },
    "requiresApproval": {
      "type": "boolean",
      "const": true
    }
  }
}
