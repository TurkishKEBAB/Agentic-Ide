{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TurkishKEBAB/Agentic-Ide/schemas/config.schema.json",
  "title": "Agentic IDE Configuration",
  "description": "Planning contract with proposed privacy constraints; runtime enforcement and platform secret storage are not implemented. See ADR-010.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultProviderMode", "providers", "privacy"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "defaultProviderMode": {
      "type": "string",
      "enum": ["local-only", "manual-hybrid", "cloud-only"]
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anthropic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "defaultModel": { "type": "string" },
            "apiKeyRef": {
              "type": "string",
              "minLength": 1,
              "description": "Opaque non-empty reference to OS-backed or encrypted secret storage; never the raw API key. Resolved only by the main-process broker."
            }
          }
        },
        "ollama": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "baseUrl": {
              "type": "string",
              "pattern": "^https?://(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/?$",
              "description": "MVP local endpoint only: literal localhost, 127.0.0.1 or [::1], HTTP(S), optional port 1-65535 and root path. No credentials, remote hosts, query or fragment. Runtime must verify loopback resolution and reject remote redirects."
            },
            "defaultModel": { "type": "string" },
            "embeddingModel": { "type": "string" }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["respectAgentIgnore", "excludeSecretPatterns"],
      "properties": {
        "respectAgentIgnore": {
          "type": "boolean",
          "const": true,
          "description": "MVP privacy policy cannot disable .agentignore or built-in protected-file filtering."
        },
        "excludeSecretPatterns": {
          "type": "array",
          "description": "User additions only. Runtime exclusion policy is the union of immutable built-in mandatory protected patterns, .agentignore and this list; an empty list never removes mandatory exclusions.",
          "items": { "type": "string" }
        }
      }
    },
    "projectOverrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workspaceRoot"],
        "properties": {
          "workspaceRoot": { "type": "string" },
          "providerMode": {
            "type": "string",
            "enum": ["local-only", "manual-hybrid", "cloud-only"]
          },
          "defaultModel": { "type": "string" }
        }
      }
    }
  }
}
