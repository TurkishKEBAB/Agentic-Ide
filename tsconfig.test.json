{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true
  },
  "include": [
    "tests/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "vitest.security.config.ts",
    "vitest.shared.ts",
    "playwright.config.ts",
    "eslint.config.mjs"
  ]
}
