{
  "name": "agentic-ide-intent-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "diff": "8.0.4",
    "dompurify": "3.4.17",
    "monaco-editor": "0.57.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    }
  }
}
